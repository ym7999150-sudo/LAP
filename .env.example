# Neon pooled connection string (used by the app at runtime on Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Neon direct (non-pooled) connection string (used for migrations)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Secret used to HMAC-hash session tokens. Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-64-hex-chars"
# Comma-separated internal user IDs that get admin rights (never display names)
ADMIN_USER_IDS=""
# Public branding (safe to expose)
NEXT_PUBLIC_APP_NAME="LabVerse 3D"
